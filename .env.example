# Copie este arquivo para .env e ajuste os valores.

# Porta do servidor
PORT=3000

# Ambiente (development | production)
NODE_ENV=development

# Segredo das sessões — gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-bem-grande

# Usuário inicial criado no primeiro start (só é usado se ainda não existir)
# Padrão: Charlotte / 123456 — troque a senha no painel após o primeiro acesso.
# ADMIN_USER=Charlotte
# ADMIN_PASSWORD=123456

# Caminho opcional para o banco (padrão: database/pinturinha.db)
# DB_PATH=./database/pinturinha.db

# Pasta opcional para as fotos enviadas (padrão: uploads/)
# UPLOADS_DIR=./uploads

# Valores iniciais exibidos no site (podem ser alterados no painel)
# DEFAULT_WHATSAPP=5555000000000
# DEFAULT_EMAIL=contato@exemplo.com
