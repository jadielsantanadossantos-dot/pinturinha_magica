<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel · Pinturinha Mágica</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🎨</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
    <header class="admin-topbar">
        <div class="admin-topbar-inner">
            <a class="admin-brand" href="/admin">
                <span aria-hidden="true">🎨</span>
                <span><strong>Pinturinha</strong> <em>Mágica</em></span>
            </a>

            <div class="admin-topbar-actions">
                <span class="admin-user">Olá, <strong><%= currentUser ? currentUser.username : 'artista' %></strong></span>
                <a href="/" target="_blank" rel="noopener" class="admin-btn admin-btn--ghost admin-btn--sm">Ver site ↗</a>
                <form action="/admin/logout" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="admin-btn admin-btn--dark admin-btn--sm">Sair</button>
                </form>
            </div>
        </div>
    </header>

    <main class="admin-main">
        <div class="admin-container">
            <% if (flash) { %>
                <div class="admin-alert admin-alert--<%= flash.type %>" role="status">
                    <span><%= flash.type === 'success' ? '✅' : flash.type === 'error' ? '⚠️' : 'ℹ️' %></span>
                    <p><%= flash.message %></p>
                </div>
            <% } %>

            <div class="admin-stats">
                <article class="stat-card">
                    <span class="stat-icon stat-icon--pink">📩</span>
                    <div><strong><%= stats.pending_bookings || 0 %></strong><span>Pedidos aguardando</span></div>
                </article>
                <article class="stat-card">
                    <span class="stat-icon stat-icon--teal">📅</span>
                    <div><strong><%= stats.busy_dates || 0 %></strong><span>Datas ocupadas</span></div>
                </article>
                <article class="stat-card">
                    <span class="stat-icon stat-icon--yellow">🖼️</span>
                    <div><strong><%= stats.total_photos || 0 %></strong><span>Fotos na galeria</span></div>
                </article>
                <article class="stat-card">
                    <span class="stat-icon stat-icon--purple">💌</span>
                    <div><strong><%= stats.unread_messages || 0 %></strong><span>Mensagens novas</span></div>
                </article>
            </div>

            <nav class="admin-tabs" aria-label="Seções do painel">
                <button type="button" class="admin-tab" data-tab="bookings">
                    Pedidos <% if (stats.pending_bookings) { %><span class="tab-badge"><%= stats.pending_bookings %></span><% } %>
                </button>
                <button type="button" class="admin-tab" data-tab="schedule">Agenda</button>
                <button type="button" class="admin-tab" data-tab="gallery">Galeria</button>
                <button type="button" class="admin-tab" data-tab="messages">
                    Mensagens <% if (stats.unread_messages) { %><span class="tab-badge"><%= stats.unread_messages %></span><% } %>
                </button>
                <button type="button" class="admin-tab" data-tab="settings">Configurações</button>
            </nav>

            <!-- PEDIDOS -->
            <section class="admin-panel" id="panel-bookings" data-panel="bookings">
                <%
                    const quoteRequests = bookings.filter(item => item.status !== 'confirmed');
                %>

                <div class="panel-head">
                    <div>
                        <h2>Pedidos de orçamento</h2>
                        <p>Confirme, cancele ou remova pedidos. Ao confirmar, o pedido sai desta aba e passa a aparecer somente na Agenda.</p>
                    </div>
                </div>

                <% if (!quoteRequests.length) { %>
                    <div class="admin-empty">
                        <span>📭</span>
                        <h3>Nenhum pedido pendente</h3>
                        <p>Novos pedidos aparecem aqui. Os confirmados ficam na Agenda.</p>
                    </div>
                <% } else { %>
                    <div class="booking-list">
                        <% quoteRequests.forEach(booking => { %>
                            <article class="booking-card <%= booking.status === 'cancelled' ? 'is-cancelled' : '' %>">
                                <header class="booking-head">
                                    <div>
                                        <span class="booking-date"><%= formatDate(booking.event_date) %></span>
                                        <span class="booking-meta">🕒 <%= booking.event_time || 'horário a definir' %></span>
                                    </div>
                                    <span class="badge badge--<%= booking.status %>"><%= bookingStatus[booking.status] || booking.status %></span>
                                </header>

                                <div class="booking-body">
                                    <div class="booking-info">
                                        <h3><%= booking.parent_name %></h3>
                                        <p class="booking-contact">📱 <%= formatPhone(booking.contact) || booking.contact %> · <%= booking.event_type || 'Evento' %></p>
                                        <p>📍 <%= booking.location %></p>
                                        <% if (booking.estimated_children) { %>
                                            <p>👧 <%= booking.estimated_children %> crianças (estimativa)</p>
                                        <% } %>
                                        <% if (booking.observations) { %>
                                            <p class="booking-note">📝 <%= booking.observations %></p>
                                        <% } %>
                                        <% if (booking.created_at) { %>
                                            <p class="booking-created">Recebido em <%= formatDateTime(booking.created_at) %></p>
                                        <% } %>
                                    </div>

                                    <div class="booking-actions">
                                        <%
                                            const bookingWa = waLink(
                                                booking.contact,
                                                `Olá, ${booking.parent_name}! Tudo bem? Aqui é da Pinturinha Mágica. Estou entrando em contato sobre o pedido de orçamento para ${formatDate(booking.event_date)}. 🎨`
                                            );
                                        %>
                                        <% if (bookingWa) { %>
                                            <a
                                                href="<%= bookingWa %>"
                                                target="_blank"
                                                rel="noopener"
                                                class="admin-btn admin-btn--whatsapp admin-btn--sm">
                                                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                                    <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                                                </svg>
                                                WhatsApp
                                            </a>
                                        <% } %>

                                        <form action="/admin/bookings/status/<%= booking.id %>" method="POST" class="inline-form">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <label for="status-<%= booking.id %>" class="sr-only">Status do pedido</label>
                                            <select id="status-<%= booking.id %>" name="status" class="admin-select">
                                                <% Object.entries(bookingStatus).forEach(([value, label]) => { %>
                                                    <option value="<%= value %>" <%= booking.status === value ? 'selected' : '' %>><%= label %></option>
                                                <% }) %>
                                            </select>
                                            <button type="submit" class="admin-btn admin-btn--primary admin-btn--sm">Atualizar</button>
                                        </form>

                                        <form action="/admin/bookings/delete/<%= booking.id %>" method="POST" data-confirm="Remover este pedido? Essa ação não pode ser desfeita.">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="admin-btn admin-btn--danger-ghost admin-btn--sm">Remover</button>
                                        </form>
                                    </div>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </section>

            <!-- AGENDA -->
            <section class="admin-panel" id="panel-schedule" data-panel="schedule">
                <div class="panel-head">
                    <div>
                        <h2>Agenda</h2>
                        <p>Cadastre eventos, bloqueie datas e acompanhe as reservas feitas pelos pedidos.</p>
                    </div>
                    <button type="button" class="admin-btn admin-btn--primary" data-open-event>
                        + Adicionar evento
                    </button>
                </div>

                <%
                    const agendaEvents = bookings
                        .filter(item => item.status !== 'cancelled')
                        .slice()
                        .sort((a, b) => a.event_date.localeCompare(b.event_date));
                    const eventDates = new Set(agendaEvents.map(item => item.event_date));
                    const manualSchedule = schedule.filter(item => !eventDates.has(item.date));
                %>

                <div class="agenda-events">
                    <div class="agenda-events-head">
                        <h3>Eventos</h3>
                        <span><%= agendaEvents.length %> <%= agendaEvents.length === 1 ? 'evento' : 'eventos' %></span>
                    </div>

                    <% if (!agendaEvents.length) { %>
                        <div class="admin-empty admin-empty--sm">
                            <p>Nenhum evento cadastrado. Use “+ Adicionar evento” para começar.</p>
                        </div>
                    <% } else { %>
                        <div class="agenda-event-list">
                            <% agendaEvents.forEach(item => { %>
                                <article class="agenda-event">
                                    <div class="agenda-event-when">
                                        <strong><%= formatDate(item.event_date) %></strong>
                                        <span><%= item.event_time || 'Horário a definir' %></span>
                                    </div>

                                    <div class="agenda-event-info">
                                        <strong><%= item.parent_name %></strong>
                                        <span><%= item.event_type || 'Evento' %><% if (item.location) { %> · <%= item.location %><% } %></span>
                                        <% if (item.estimated_children) { %>
                                            <small><%= item.estimated_children %> crianças (estimativa)</small>
                                        <% } %>
                                    </div>

                                    <span class="badge badge--<%= item.status %>"><%= bookingStatus[item.status] || item.status %></span>

                                    <button
                                        type="button"
                                        class="admin-btn admin-btn--ghost admin-btn--sm"
                                        data-edit-event
                                        data-id="<%= item.id %>"
                                        data-name="<%= item.parent_name %>"
                                        data-contact="<%= item.contact || '' %>"
                                        data-type="<%= item.event_type || 'Outro' %>"
                                        data-date="<%= item.event_date %>"
                                        data-time="<%= item.event_time || '' %>"
                                        data-children="<%= item.estimated_children || '' %>"
                                        data-location="<%= item.location || '' %>"
                                        data-notes="<%= item.observations || '' %>"
                                        data-status="<%= item.status %>">
                                        Editar
                                    </button>
                                </article>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <div class="agenda-dates-head">
                    <h3>Bloqueios e datas</h3>
                    <span>Use esta área para marcar datas sem evento.</span>
                </div>

                <form action="/admin/schedule/add" method="POST" class="admin-form admin-form--inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="admin-field">
                        <label for="schedule-date">Data</label>
                        <input type="date" id="schedule-date" name="date" required>
                    </div>
                    <div class="admin-field">
                        <label for="schedule-status">Situação</label>
                        <select id="schedule-status" name="status" class="admin-select">
                            <% Object.entries(scheduleStatus).forEach(([value, label]) => { %>
                                <option value="<%= value %>"><%= label %></option>
                            <% }) %>
                        </select>
                    </div>
                    <button type="submit" class="admin-btn admin-btn--primary">Salvar data</button>
                </form>

                <% if (!manualSchedule.length) { %>
                    <div class="admin-empty admin-empty--sm">
                        <p>Nenhum bloqueio manual. As datas dos eventos aparecem na lista acima.</p>
                    </div>
                <% } else { %>
                    <div class="schedule-list">
                        <% manualSchedule.forEach(item => { %>
                            <div class="schedule-row">
                                <span class="schedule-date"><%= formatDate(item.date) %></span>
                                <span class="badge badge--<%= item.status %>"><%= scheduleStatus[item.status] || item.status %></span>
                                <form action="/admin/schedule/delete/<%= item.id %>" method="POST" data-confirm="Remover esta data da agenda?">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" class="admin-btn admin-btn--danger-ghost admin-btn--sm">Remover</button>
                                </form>
                            </div>
                        <% }) %>
                    </div>
                <% } %>

                <dialog class="admin-dialog" id="event-dialog">
                    <form action="/admin/bookings/create" method="POST" class="admin-dialog-form" id="event-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                        <header class="admin-dialog-head">
                            <div>
                                <h2 id="event-dialog-title">Adicionar evento</h2>
                                <p id="event-dialog-subtitle">Cadastre um evento fechado por WhatsApp, telefone ou pessoalmente.</p>
                            </div>
                            <button type="button" class="admin-dialog-close" data-close-event aria-label="Fechar">✕</button>
                        </header>

                        <div class="admin-dialog-body">
                            <div class="admin-form-grid admin-form-grid--2">
                                <div class="admin-field">
                                    <label for="event-name">Cliente / responsável *</label>
                                    <input type="text" id="event-name" name="parent_name" placeholder="Nome de quem contratou" required maxlength="120">
                                </div>
                                <div class="admin-field">
                                    <label for="event-contact">Contato</label>
                                    <input type="text" id="event-contact" name="contact" placeholder="WhatsApp, telefone ou e-mail" maxlength="120">
                                </div>
                                <div class="admin-field">
                                    <label for="event-type">Tipo de evento</label>
                                    <select id="event-type" name="event_type" class="admin-select">
                                        <% ['Aniversário', 'Festa Escolar', 'Evento Corporativo', 'Festival', 'Outro'].forEach(type => { %>
                                            <option value="<%= type %>"><%= type %></option>
                                        <% }) %>
                                    </select>
                                </div>
                                <div class="admin-field">
                                    <label for="event-status">Situação</label>
                                    <select id="event-status" name="status" class="admin-select">
                                        <option value="confirmed">Confirmado</option>
                                        <option value="pending">Aguardando confirmação</option>
                                    </select>
                                </div>
                                <div class="admin-field">
                                    <label for="event-date">Data do evento *</label>
                                    <input type="date" id="event-date" name="event_date" required>
                                </div>
                                <div class="admin-field">
                                    <label for="event-time">Horário</label>
                                    <input type="time" id="event-time" name="event_time">
                                </div>
                                <div class="admin-field">
                                    <label for="event-children">Crianças (estimativa)</label>
                                    <input type="number" id="event-children" name="estimated_children" min="1" max="500" placeholder="Ex: 20">
                                </div>
                                <div class="admin-field">
                                    <label for="event-location">Local</label>
                                    <input type="text" id="event-location" name="location" placeholder="Endereço ou nome do salão" maxlength="300">
                                </div>
                            </div>

                            <div class="admin-field">
                                <label for="event-notes">Observações</label>
                                <textarea id="event-notes" name="observations" rows="3" placeholder="Tema, detalhes combinados, pagamento..." maxlength="1000"></textarea>
                            </div>
                        </div>

                        <footer class="admin-dialog-actions">
                            <button type="button" class="admin-btn admin-btn--ghost" data-close-event>Cancelar</button>
                            <button type="submit" class="admin-btn admin-btn--primary" id="event-dialog-submit">Salvar evento</button>
                        </footer>
                    </form>
                </dialog>
            </section>

            <!-- GALERIA -->
            <section class="admin-panel" id="panel-gallery" data-panel="gallery">
                <div class="panel-head">
                    <div>
                        <h2>Galeria</h2>
                        <p>Envie até 10 fotos por vez. Formatos aceitos: JPG, PNG, WEBP e GIF (máx. 8 MB cada).</p>
                    </div>
                </div>

                <form action="/admin/gallery/add" method="POST" enctype="multipart/form-data" class="admin-form admin-form--upload">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <label class="upload-zone" for="photos">
                        <span class="upload-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4m0 0L7 9m5-5 5 5"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
                        </span>
                        <strong>Clique para escolher as fotos</strong>
                        <small>Você pode selecionar várias imagens de uma vez.</small>
                        <input type="file" id="photos" name="photos" accept="image/jpeg,image/png,image/webp,image/gif" multiple required>
                    </label>
                    <div class="upload-preview" id="upload-preview"></div>

                    <div class="admin-form-grid">
                        <div class="admin-field">
                            <label for="caption">Legenda das fotos</label>
                            <input type="text" id="caption" name="caption" placeholder="Ex: Unicórnio com glitter" maxlength="200">
                        </div>
                        <div class="admin-field">
                            <label for="category">Categoria</label>
                            <select id="category" name="category" class="admin-select">
                                <% categories.forEach(category => { %>
                                    <option value="<%= category %>"><%= category %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="admin-field admin-field--action">
                            <button type="submit" class="admin-btn admin-btn--primary">Adicionar à galeria</button>
                        </div>
                    </div>
                </form>

                <% if (!photos.length) { %>
                    <div class="admin-empty admin-empty--sm">
                        <p>Nenhuma foto cadastrada ainda.</p>
                    </div>
                <% } else { %>
                    <div class="admin-gallery">
                        <% photos.forEach(photo => { %>
                            <figure class="admin-photo">
                                <img src="/uploads/<%= photo.filename %>" alt="<%= photo.caption || 'Foto da galeria' %>" loading="lazy">
                                <figcaption>
                                    <span class="tag"><%= photo.category || 'Outro' %></span>
                                    <p><%= photo.caption || 'Sem legenda' %></p>
                                    <form action="/admin/gallery/delete/<%= photo.id %>" method="POST" data-confirm="Remover esta foto da galeria?">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="admin-btn admin-btn--danger-ghost admin-btn--sm">Remover</button>
                                    </form>
                                </figcaption>
                            </figure>
                        <% }) %>
                    </div>
                <% } %>
            </section>

            <!-- MENSAGENS -->
            <section class="admin-panel" id="panel-messages" data-panel="messages">
                <div class="panel-head">
                    <div>
                        <h2>Mensagens de contato</h2>
                        <p>Mensagens enviadas pelo formulário do site.</p>
                    </div>
                </div>

                <% if (!messages.length) { %>
                    <div class="admin-empty admin-empty--sm">
                        <p>Nenhuma mensagem recebida ainda.</p>
                    </div>
                <% } else { %>
                    <div class="message-list">
                        <% messages.forEach(message => { %>
                            <article class="message-card <%= message.is_read ? '' : 'is-unread' %>">
                                <header>
                                    <div>
                                        <h3><%= message.name %></h3>
                                        <p class="message-contact"><%= message.contact %></p>
                                    </div>
                                    <div class="message-meta">
                                        <% if (!message.is_read) { %><span class="badge badge--new">Nova</span><% } %>
                                        <span><%= formatDateTime(message.created_at) %></span>
                                    </div>
                                </header>
                                <p class="message-body"><%= message.message %></p>
                                <footer>
                                    <% if (!message.is_read) { %>
                                        <form action="/admin/messages/<%= message.id %>/read" method="POST">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm">Marcar como lida</button>
                                        </form>
                                    <% } %>
                                    <form action="/admin/messages/<%= message.id %>/delete" method="POST" data-confirm="Excluir esta mensagem?">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="admin-btn admin-btn--danger-ghost admin-btn--sm">Excluir</button>
                                    </form>
                                </footer>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </section>

            <!-- CONFIGURAÇÕES -->
            <section class="admin-panel" id="panel-settings" data-panel="settings">
                <div class="panel-head">
                    <div>
                        <h2>Configurações</h2>
                        <p>Dados exibidos no site e segurança do acesso.</p>
                    </div>
                </div>

                <div class="settings-grid">
                    <form action="/admin/settings/update" method="POST" class="admin-form admin-card">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <h3>Informações do site</h3>

                        <div class="admin-field">
                            <label for="whatsapp">WhatsApp (DDD + número)</label>
                            <input type="text" id="whatsapp" name="whatsapp" value="<%= site.whatsapp || '' %>" placeholder="83999998888" maxlength="30">
                            <small class="field-hint">Usado nos botões do site. O código do país é adicionado automaticamente.</small>
                        </div>

                        <div class="admin-field">
                            <label for="email">E-mail de contato</label>
                            <input type="email" id="email" name="email" value="<%= site.email || '' %>" placeholder="contato@exemplo.com" maxlength="160">
                        </div>

                        <div class="admin-field">
                            <label for="instagram">Instagram</label>
                            <input type="text" id="instagram" name="instagram" value="<%= site.instagram || '' %>" placeholder="pinturinhamagica" maxlength="80">
                        </div>

                        <div class="admin-field">
                            <label for="artist_name">Nome da artista</label>
                            <input type="text" id="artist_name" name="artist_name" value="<%= site.artist_name || '' %>" placeholder="Como você quer aparecer na página Sobre" maxlength="120">
                        </div>

                        <div class="admin-field">
                            <label for="hero_text">Frase da página inicial</label>
                            <textarea id="hero_text" name="hero_text" rows="3" maxlength="200" placeholder="Arte na pele para festas, eventos escolares e festivais..."><%= site.hero_text || '' %></textarea>
                        </div>

                        <button type="submit" class="admin-btn admin-btn--primary">Salvar informações</button>
                    </form>

                    <form action="/admin/password" method="POST" class="admin-form admin-card">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <h3>Segurança</h3>
                        <p class="admin-card-note">Troque a senha padrão para manter o painel protegido.</p>

                        <div class="admin-field">
                            <label for="current_password">Senha atual</label>
                            <input type="password" id="current_password" name="current_password" autocomplete="current-password" required>
                        </div>

                        <div class="admin-field">
                            <label for="new_password">Nova senha</label>
                            <input type="password" id="new_password" name="new_password" minlength="8" autocomplete="new-password" required>
                            <small class="field-hint">Mínimo de 8 caracteres.</small>
                        </div>

                        <div class="admin-field">
                            <label for="confirm_password">Confirmar nova senha</label>
                            <input type="password" id="confirm_password" name="confirm_password" minlength="8" autocomplete="new-password" required>
                        </div>

                        <button type="submit" class="admin-btn admin-btn--dark">Alterar senha</button>
                    </form>
                </div>
            </section>
        </div>
    </main>

    <script src="/js/admin.js" defer></script>
</body>
</html>
